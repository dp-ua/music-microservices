{
  "uid": "logs-trace",
  "title": "Logs by Trace ID",
  "tags": [
    "music-microservices",
    "logs",
    "tracing"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "traceId",
        "label": "Trace ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Value of the X-Trace-Id response header of the gateway"
      },
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "api-gateway,resource-service,resource-processor,song-service,storage-service",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Logs of all services with the trace ID (oldest first)",
      "type": "logs",
      "datasource": {
        "type": "elasticsearch",
        "uid": "elasticsearch"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 18
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "elasticsearch"
          },
          "query": "traceId:\"$traceId\" AND service.name:$service",
          "queryType": "lucene",
          "metrics": [
            {
              "id": "1",
              "type": "logs",
              "settings": {
                "limit": "500",
                "sortDirection": "asc"
              }
            }
          ],
          "bucketAggs": [],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latest ERROR and WARN logs (all services)",
      "type": "logs",
      "datasource": {
        "type": "elasticsearch",
        "uid": "elasticsearch"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "elasticsearch"
          },
          "query": "log.level:(ERROR OR WARN)",
          "queryType": "lucene",
          "metrics": [
            {
              "id": "1",
              "type": "logs",
              "settings": {
                "limit": "500",
                "sortDirection": "desc"
              }
            }
          ],
          "bucketAggs": [],
          "timeField": "@timestamp"
        }
      ]
    }
  ]
}