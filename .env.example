# Resource DB
RESOURCE_DB_NAME=resource_service
RESOURCE_DB_USER=postgres
RESOURCE_DB_PASSWORD=postgres
RESOURCE_DB_URL=jdbc:postgresql://resource-db:5432/resource_service

# Song DB
SONG_DB_NAME=song_service
SONG_DB_USER=postgres
SONG_DB_PASSWORD=postgres
SONG_DB_URL=jdbc:postgresql://song-db:5432/song_service

# Storage DB (storage-service)
STORAGE_DB_NAME=storage_service
STORAGE_DB_USER=postgres
STORAGE_DB_PASSWORD=postgres
STORAGE_DB_URL=jdbc:postgresql://storage-db:5432/storage_service

# Buckets created in LocalStack, they match the storages pre-created by init-scripts/storage-db/init.sql
STAGING_BUCKET=staging-bucket
PERMANENT_BUCKET=permanent-bucket

# S3 (LocalStack) used by resource-service. The buckets (STAGING / PERMANENT) are described by storage-service.
S3_ENDPOINT=http://localstack:4566
S3_REGION=us-east-1
S3_ACCESS_KEY=test
S3_SECRET_KEY=test

# RabbitMQ (message broker) used by resource-service and resource-processor.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=rabbit
RABBITMQ_PASSWORD=rabbit
RABBITMQ_QUEUE=resource.uploaded

# Eureka Server URL (used by all microservices for service discovery)
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/

# Queue "resource processed": resource-processor -> resource-service (STAGING -> PERMANENT)
RABBITMQ_PROCESSED_QUEUE=resource.processed
